PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas: replace every placeholder with your own cluster details.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/parkops?retryWrites=true&w=majority

# Generate a unique random secret with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h

# Initial capacities. They are stored in MongoDB on the first server start.
VIP_CAPACITY=20
NORMAL_CAPACITY=80
